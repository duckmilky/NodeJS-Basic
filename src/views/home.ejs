<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/common.css">
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- navbar -->
        <nav class="navbar">
            <ul class="nav-list">
                <li class="nav-item"><a class="nav-link" href="/"><span>Home</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/usermanager"><span>UserManager</span></a></li>  
                <li class="nav-item"><a class="nav-link" href="/login"><span>Login</span></a></li>  
                <li class="nav-item"><a class="nav-link" href="/logout"><span>Logout</span></a></li>
            </ul>    
        <!-- navbar -->
        </nav>

        <!-- <%= JSON.stringify(data) %> -->

        <!-- content -->
        <div class="wp-content">
            <h1>List User</h1>

            <form class="frm_action" action="/add-user" method="get">
                <button class="btn_addUser" type="submit">Add new User</button>
            </form>
            
            <table>
                <tr>
                    <th>ID</th>
                    <th>NAME</th>
                    <th>DATE</th>
                    <th>SEX</th>
                    <th>ADDRESS</th>
                    <th>ACTION</th>
                </tr>

                <% data.forEach((user) => { %>
                    <tr>
                        <td><%= user.id %></td>
                        <td><%= user.fullName %></td>                              
                        <% var m = new Date(user.dateOfBirth); var month = (m.getUTCMonth() + 1).toString().padStart(2, 0); var day = (m.getUTCDate() + 1).toString().padStart(2, 0); var dateString = day +"-"+ month +"-"+  m.getUTCFullYear()%>
                        <td><%= dateString %></td>
                        <td><%=  %>
                            <% if(user.sex=='1') { %>
                                Nam
                            <% } else { %>
                                Nữ 
                            <% } %>
                        </td>
                        <td><%= user.address %></td>
                        <td><a href="/edit-user/<%= user.id %>">Sửa</a> | <a class="delete" href="/delete-user/<%= user.id %>">Xóa</a></td>
                    </tr>
                <% }) %>
            </table>
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let lists = document.querySelectorAll(".delete");
            lists.forEach(function (item) {
                item.addEventListener("click", function (event) {
                    let userConfirm = confirm("Bạn có chắc chắn muốn xóa User này không ?");
                    if (!userConfirm) {
                        event.preventDefault(); // Ngăn chặn chuyển trang
                    }
                });
            });
        });
    </script>
</body>
</html>