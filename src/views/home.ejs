<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/common.css">
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- navbar -->
        <nav class="navbar">
            <ul class="nav-list">
                <li class="nav-item"><a class="nav-link" href="/"><span>Home</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/usermanager"><span>UserManager</span></a></li>  
                <li class="nav-item"><a class="nav-link" href="/login"><span>Login</span></a></li>  
                <li class="nav-item"><a class="nav-link" href="/logout"><span>Logout</span></a></li>
            </ul>    
        <!-- navbar -->
        </nav>

        <!-- <%= JSON.stringify(data) %> -->

        <!-- content -->
        <div class="wp-content">
            <h1>List User</h1>

            <form class="frm_action" action="/create-user" method="get">
                <button class="btn_addUser" type="submit">Add new User</button>
            </form>
            
            <table>
                <tr>
                    <th>ID</th>
                    <th>NAME</th>
                    <th>DATE</th>
                    <th>SEX</th>
                    <th>ADDRESS</th>
                    <th>ACTION</th>
                </tr>

                <% data.forEach((user) => { %>
                    <tr>
                        <td><%= user.id %></td>
                        <td><%= user.fullName %></td>                              
                        <% var m = new Date(user.dateOfBirth); var dateString = m.getUTCDate() +"/"+ (m.getUTCMonth()+1) +"/"+ m.getUTCFullYear() %>
                        <td><%= dateString %></td>
                        <td><%=  %>
                            <% if(user.sex=='1') { %>
                                Nam
                            <% } else { %>
                                Nữ 
                            <% } %>
                        </td>
                        <td><%= user.address %></td>
                        <td><a href="">Sửa</a> | <a href="">Xóa</a></td>
                    </tr>
                <% }) %>
            </table>
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
</body>
</html>