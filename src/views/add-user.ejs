<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/frmAddUser.css">
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- navbar -->
        <nav class="navbar">
            <ul class="nav-list">
                <li class="nav-item"><a class="nav-link" href="/"><span>Home</span></a></li>
                <li class="nav-item"><a class="nav-link" href="/usermanager"><span>UserManager</span></a></li>  
                <li class="nav-item"><a class="nav-link" href="/login"><span>Login</span></a></li>  
                <li class="nav-item"><a class="nav-link" href="/logout"><span>Logout</span></a></li>
            </ul>    
        <!-- navbar -->
        </nav>

        <!-- content -->
        <div class="wp-content">
            <h1>Add new User</h1>
            <form class="form-add" action="create-user" method="post">
                <div class="input-group">
                    <label for="">Name:</label>
                    <input type="text" name="name">
                </div>
                <div class="input-group">
                    <label for="">Date of birth:</label>
                    <input type="date" name="date">
                </div>
                <div class="input-group">
                    <label for="">Sex:</label>
                    <select name="sex" id="">
                        <option value="1" selected>Nam</option>
                        <option value="0" >Nữ</option>
                    </select>
                </div>
                <div class="input-group">
                    <label for="">Address:</label>
                    <input type="text" name="address">
                </div>
                <div class="input-group">
                    <button type="submit">Add</button>
                </div>        
            </form>       
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
</body>
</html>